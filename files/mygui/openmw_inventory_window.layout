<?xml version="1.0" encoding="UTF-8"?>

<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Window_Pinnable" layer="Windows" position="0 0 600 300" name="_Main">
        <Property key="MinSize" value="360 220"/>

        <Widget type="Widget" skin="" position="0 0 224 223" align="Left Top" name="LeftPane">
            <!-- Paper doll only. Encumbrance was moved to the shared bottom bar. -->
            <Widget type="Widget" skin="MW_Box" position="8 8 212 215" name="Avatar" align="Left Top Stretch">
                <Widget type="ImageBox" skin="ImageBox" position="3 3 206 188" align="Stretch" name="AvatarImage">
                    <UserString key="ToolTipType" value="AvatarItemSelection"/>
                </Widget>
                <Widget type="TextBox" skin="ProgressText" position="0 191 212 24" align="HStretch Bottom" name="ArmorRating">
                    <Property key="NeedMouse" value="false"/>
                </Widget>
            </Widget>
        </Widget>

        <Widget type="Widget" skin="" position="228 0 350 223" align="Left Top" name="RightPane">
            <!-- Top row is deliberately filters/sorting only. -->
            <Widget type="HBox" position="0 6 350 28" align="Left Top HStretch" name="Categories">
                <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 60 24" name="AllButton">
                    <Property key="Caption" value="#{sAllTab}"/>
                    <Property key="NeedKey" value="false"/>
                </Widget>
                <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 60 24" name="WeaponButton">
                    <Property key="Caption" value="#{sWeaponTab}"/>
                    <Property key="NeedKey" value="false"/>
                </Widget>
                <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 60 24" name="ApparelButton">
                    <Property key="Caption" value="#{sApparelTab}"/>
                    <Property key="NeedKey" value="false"/>
                </Widget>
                <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 60 24" name="MagicButton">
                    <Property key="Caption" value="#{sMagicTab}"/>
                    <Property key="NeedKey" value="false"/>
                </Widget>
                <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 60 24" name="MiscButton">
                    <Property key="Caption" value="#{sMiscTab}"/>
                    <Property key="NeedKey" value="false"/>
                </Widget>
                <Widget type="AutoSizedButton" skin="MW_Button" position="0 0 60 24" name="KeysButton">
                    <Property key="Caption" value="#{arenamp=inventory.keys}"/>
                    <Property key="NeedKey" value="false"/>
                </Widget>
            </Widget>

            <!-- Items in inventory. Runtime layout reserves the bottom control strip. -->
            <Widget type="ItemView" skin="MW_ItemView" position="0 38 350 149" name="ItemView" align="Left Top Stretch">
            </Widget>

            <!-- Bottom strip: paper doll, used weight, view mode and search.
                 The key ring itself is a virtual item inside ItemView. -->
            <Widget type="Widget" skin="" position="0 191 350 32" align="Left Bottom HStretch" name="BottomBar">
                <Widget type="MWDynamicStat" skin="MW_ChargeBar_Blue" position="80 4 104 24" name="EncumbranceBar" align="Left Top">
                </Widget>
                <Widget type="EditBox" skin="MW_TextBoxEditWithBorder" position="220 4 130 24" name="FilterEdit" align="Left Top HStretch">
                    <UserString key="AcceptTab" value="true"/>
                </Widget>
            </Widget>
        </Widget>
    </Widget>
</MyGUI>
