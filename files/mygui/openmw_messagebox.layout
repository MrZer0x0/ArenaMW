<?xml version="1.0" encoding="UTF-8"?>

<MyGUI type="Layout">
    <!-- ArenaMP transient notification: no panel, no frame, only shadowed text. -->
    <Widget type="VBox" skin="" layer="Notification" position="0 0 0 0" name="_Main">
        <Property key="Padding" value="0"/>
        <Property key="AutoResize" value="true"/>
        <Property key="NeedMouse" value="false"/>

        <Widget type="AutoSizedEditBox" skin="MW_TextEditClient" position="0 0 520 0" name="message" align="Left Top">
            <Property key="FontName" value="Default"/>
            <Property key="TextAlign" value="Center"/>
            <Property key="Static" value="true"/>
            <Property key="WordWrap" value="true"/>
            <Property key="MultiLine" value="1"/>
            <Property key="VisibleVScroll" value="0"/>
            <Property key="NeedMouse" value="false"/>
            <Property key="TextShadow" value="true"/>
            <Property key="TextShadowColour" value="0 0 0"/>
        </Widget>
    </Widget>
</MyGUI>
