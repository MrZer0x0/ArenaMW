<?xml version="1.0" encoding="UTF-8"?>

<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Window" layer="Windows" position="0 0 680 365" name="_Main">
        <Property key="MinSize" value="560 340"/>
        <Property key="Visible" value="false"/>

        <Widget type="HBox" position="8 7 646 26" align="Left Top HStretch" name="Categories">
            <Widget type="AutoSizedButton" skin="MW_Button" name="AllButton">
                <Property key="Caption" value="#{sAllTab}"/>
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="WeaponButton">
                <Property key="Caption" value="#{sWeaponTab}"/>
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="ApparelButton">
                <Property key="Caption" value="#{sApparelTab}"/>
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="MagicButton">
                <Property key="Caption" value="#{sMagicTab}"/>
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="MiscButton">
                <Property key="Caption" value="#{sMiscTab}"/>
                <Property key="NeedKey" value="false"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" name="KeysButton">
                <Property key="Caption" value="#{arenamp=inventory.keys}"/>
                <Property key="NeedKey" value="false"/>
            </Widget>
        </Widget>

        <Widget type="ItemView" skin="MW_ItemView" position="8 38 646 246" name="ItemView" align="Left Top Stretch"/>

        <Widget type="Widget" skin="" position="8 292 646 28" align="Left Bottom HStretch" name="BottomBar">
            <Widget type="MWDynamicStat" skin="MW_ChargeBar_Blue" position="0 2 122 24" name="EncumbranceBar" align="Left Top"/>
            <Widget type="EditBox" skin="MW_TextBoxEditWithBorder" position="160 2 328 24" name="FilterEdit" align="Left Top HStretch">
                <Property key="MultiLine" value="false"/>
                <UserString key="AcceptTab" value="true"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" position="498 2 0 24" name="TakeButton" align="Right Top">
                <Property key="Caption" value="#{sTakeAll}"/>
            </Widget>
            <Widget type="AutoSizedButton" skin="MW_Button" position="590 2 0 24" name="CloseButton" align="Right Top">
                <Property key="Caption" value="#{sClose}"/>
            </Widget>
        </Widget>
    </Widget>
</MyGUI>
